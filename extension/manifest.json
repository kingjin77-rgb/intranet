{
  "manifest_version": 3,
  "name": "제이엘 인트라넷",
  "version": "1.1.0",
  "description": "인트라넷을 메신저처럼 작은 창으로 열고, 새 문서·컨펌 차례를 아이콘 숫자로 알려줍니다.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "제이엘 인트라넷 열기",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kingjin77-rgb.github.io/intranet/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage"
  ]
}
